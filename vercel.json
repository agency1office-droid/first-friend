{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/public-animals",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/public-lost-animals",
      "schedule": "10 19 * * *"
    },
    {
      "path": "/api/cron/animal-ai",
      "schedule": "20 19 * * *"
    }
  ]
}
