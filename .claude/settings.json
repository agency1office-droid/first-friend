{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/preflight.mjs", "timeout": 30, "statusMessage": "퍼스트프렌드 저장소 사전 확인 중..." }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/git-gate.mjs", "timeout": 1200, "statusMessage": "git 가드: 커밋 전 lint·타입 검사, push 전 npm test 실행 중..." }
        ]
      }
    ]
  }
}
